[phases.setup]
nixPkgs = ["nodejs_20", "nodePackages.npm"]

[phases.install]
cmds = ["npm install"]

[phases.build]
cmds = [
  "cd dashboard && npm install && npm run build && cd ..",
  "npx prisma generate --schema=prisma/schema.prisma"
]

[start]
cmd = "npx prisma migrate deploy --schema=prisma/schema.prisma && node src/server.js"
