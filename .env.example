# ============================================================
# BharatKit Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bharatkit?schema=public"

# JWT — use a strong random 256-bit key in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-random-256-bit-secret"

# Redis (optional — falls back to in-memory if not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay — get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# UIDAI (Aadhaar) — requires AUA/KUA license from UIDAI
UIDAI_API_URL="https://api.uidai.gov.in"
UIDAI_API_KEY="your_uidai_api_key"

# GST Portal — requires NIC/GSTN API access
GST_API_URL="https://api.gst.gov.in"
GST_API_KEY="your_gst_api_key"

# DigiLocker — requires MeitY partnership
DIGILOCKER_CLIENT_ID="your_digilocker_client_id"
DIGILOCKER_CLIENT_SECRET="your_digilocker_client_secret"

# Account Aggregator — requires RBI AA license or partner
ACCOUNT_AGGREGATOR_URL="https://api.accountaggregator.org.in"
ACCOUNT_AGGREGATOR_KEY="your_aa_key"

# Email (SMTP) — use Gmail App Password or SendGrid/Mailgun
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS and password reset links)
FRONTEND_URL="http://localhost:5173"
